{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "allowUmdGlobalAccess": false,
    "declaration": false,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "skipLibCheck": true,
    "strict": true,
    "types": ["vitest/globals", "@types/wicg-file-system-access", "@webgpu/types", "node"],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts",
 ],
  "exclude": ["dist", "tests", "jest.config.js", "**/CMakeFiles"]
}
